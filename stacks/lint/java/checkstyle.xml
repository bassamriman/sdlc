<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Check: java -jar checkstyle-*-all.jar -c checkstyle.xml src -->
<module name="Checker">
  <module name="TreeWalker">
    <module name="MethodLength"><property name="max" value="15"/></module>
    <module name="ParameterNumber"><property name="max" value="3"/></module>
    <module name="CyclomaticComplexity"><property name="max" value="8"/></module>
    <module name="NestedIfDepth"><property name="max" value="1"/></module>
    <module name="NestedTryDepth"/>
    <module name="NestedForDepth"/>
    <module name="EmptyCatchBlock"/>
    <module name="EmptyBlock"/>
    <module name="UnusedImports"/>
    <module name="UnusedLocalVariable"/>
    <module name="FinalParameters"/>
    <module name="FinalLocalVariable"/>
    <module name="TodoComment"><property name="format" value="(?i)\bTODO\b(?!\s*\([A-Z]+-\d+\))"/></module>
  </module>
</module>
