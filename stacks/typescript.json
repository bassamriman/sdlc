{
  "pack": "typescript",
  "markers": [
    [
      "tsconfig.json",
      "package.json"
    ]
  ],
  "languages": [
    "typescript"
  ],
  "commands": {
    "test": "CI=true pnpm test",
    "typecheck": "pnpm exec tsc --noEmit",
    "lint": "pnpm run lint",
    "format": "pnpm exec prettier --write .",
    "run": "pnpm dev"
  },
  "check": [
    "test",
    "typecheck",
    "lint"
  ]
}
